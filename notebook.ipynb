   "source": [
    "# VECM (cointegration) setup\n",
    "from models_classical import johansen_test, fit_vecm\n",
    "\n",
    "# Levels of both FX pairs over the training window\n",
    "levels_cols = [f\"{eur_label}_Close\", f\"{gbp_label}_Close\"]\n",
    "levels_train = df.loc[y_train.index, levels_cols]\n",
    "\n",
    "# Johansen cointegration test (trace statistic vs 5% critical value)\n",
    "joh = johansen_test(levels_train)\n",
    "rank = max(int(np.sum(joh.lr1 > joh.cvt[:, 1])), 1)  # at least rank 1 for VECM\n",
    "print(\"Johansen trace statistics:\", joh.lr1)\n",
    "print(\"5% critical values:\", joh.cvt[:, 1])\n",
    "print(f\"Cointegrating rank selected: {rank}\")\n",
    "\n",
    "# Fit VECM (capped at rank 1 for the bivariate system)\n",
    "vecm_res = fit_vecm(levels_train, rank=min(rank, 1))\n",
    "vecm_fc = vecm_res.predict(steps=h)\n",
    "vecm_eur_level = vecm_fc[:, 0]\n",
    "\n",
    "# Convert level forecast to return forecast\n",
    "vecm_eur_ret_fc = np.diff(np.log(np.r_[levels_train.iloc[-1, 0], vecm_eur_level[:h]]))\n",
    "print(f\"VECM implied return forecast (first 3): {vecm_eur_ret_fc[:3]}\")"
   ]
  },
